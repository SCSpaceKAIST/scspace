    "@emotion/styled": "^11.14.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/passport": "^11.0.5",
    "aos": "^2.3.4",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
