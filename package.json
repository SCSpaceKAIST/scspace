    "@types/passport-local": "^1.0.38",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-pdf": "^7.0.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3",
    "zod": "^3.24.4"
  },
  "dependencies": {
