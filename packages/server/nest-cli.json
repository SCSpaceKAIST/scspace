{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "server/src/main",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "tools/mailer/templates/*",
        "outDir": "dist/server/src/"
      } ,
      {
        "include" : "tools/pdf/templates/*",
        "outDir" : "dist/server/src"
      }
    ]
  }
}