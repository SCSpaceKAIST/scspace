<html lang='ko'>
<head>
    <meta charset='utf-8' />
    <title>{{meta.header.kr}} / {{meta.header.en}}</title>
    <style>
        body{ font-family: 'Malgun Gothic', Arial, sans-serif; background:#f4f4f4; margin:0; padding:0; color:#333; line-height:1.6; }
        .container{ max-width:600px; margin:0 auto; background:#fff; border-radius:8px; box-shadow:0 2px 10px rgba(0,0,0,.08); }
        .header{ background:{{meta.color}}; color:#fff; text-align:center; padding:30px 20px; border-radius:8px 8px 0 0; }
        .header h1{ margin:0; font-size:24px; }
        .header h2{ margin:8px 0 0 0; font-weight:400; font-size:16px; }
        .content{ padding:30px 20px; }
        .summary{ background:#f8f9fa; padding:20px; border-radius:6px; border-left:4px solid {{meta.color}}; }
        .summary ul{ list-style:none; padding:0; margin:10px 0 0 0; }
        .summary li{ margin:10px 0; padding:10px; background:#fff; border-radius:4px; border-left:3px solid #17a2b8; display:flex; align-items:center; }
        .summary li strong{ color:#17a2b8; min-width:140px; }
        .footer{ background:#f8f9fa; border-top:1px solid #e9ecef; padding:20px; text-align:center; font-size:14px; color:#6c757d; border-radius:0 0 8px 8px; }
        @media only screen and (max-width: 600px) {
            .container{ margin:10px; border-radius:4px; }
            .header{ padding:20px 15px; }
            .content{ padding:20px 15px; }
            .summary li{ flex-direction:column; align-items:flex-start; }
            .summary li strong{ min-width:auto; margin-bottom:5px; }
        }
    </style>
</head>
<body>
<div class='container'>
    <div class='header'>
        <h1>{{meta.emoji}} {{meta.header.kr}}</h1>
        <h2>{{meta.header.en}}</h2>
        <p style='margin-top:18px'>
            {{meta.body.kr}}<br />
            {{meta.body.en}}
        </p>
    </div>

    <div class='content'>
        <div class='summary'>
            <strong>대여 정보 / Rental Details</strong>
            <ul>
                <li>
                    <strong>대여 번호:</strong>
                    <span>#{{rental.id}}</span>
                </li>
                <li>
                    <strong>대여 물품:</strong>
                    <span>{{rental.goodsName}}</span>
                </li>
                <li>
                    <strong>수량:</strong>
                    <span>{{rental.quantity}}개</span>
                </li>
                <li>
                    <strong>대여자:</strong>
                    <span>{{rental.borrowerName}}</span>
                </li>
                <li>
                    <strong>대여 구분:</strong>
                    <span>{{rental.organizationName}}</span>
                </li>
                <li>
                    <strong>대여 일시:</strong>
                    <span>{{rental.timeFrom}} KST</span>
                </li>
                <li>
                    <strong>반납 기한:</strong>
                    <span>{{rental.timeTo}} KST</span>
                </li>
            </ul>
        </div>
    </div>

    <div class='footer'>
        <p><strong>학생문화공간위원회 / Student Cultural Space Committee</strong></p>
        <p>{{meta.templateFooter}}<br />{{meta.templateFooterEn}}</p>
        <p style='margin-top:15px;color:#999;'>문의: scspace@kaist.ac.kr</p>
    </div>
</div>
</body>
</html>
