<html lang='ko'>
  <head>
    <style>
      body { font-family: monospace; margin: 40px; line-height: 1.5; background:
      #f4f4f4; } .container { margin: 0 auto; background: #fff; padding: 20px;
      border-radius: 4px; box-shadow: 0 2px 4px rgba(0,0,0,.1); } .header {
      color: #2bb03d; font-size: 24px; margin-bottom: 20px; border-bottom: 2px
      solid #1d973c; padding-bottom: 10px; } .section { margin-bottom: 20px;
      padding: 15px; background: #f8f8f8; border-left: 4px solid #486853; }
    </style>
    <title></title>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        New Organization Created:
        {{meta.organizationName}}
      </div>

      <div class='section'>
        <strong>Description:</strong>
        <br />
        {{meta.organizationDescription}}
      </div>

    </div>
  </body>
</html>